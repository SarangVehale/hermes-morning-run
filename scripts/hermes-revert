#!/usr/bin/env bash
# hermes-revert — force Hermes config back to Gemma 4 on port 8080.
# Use this if `hermes config show` shows the fast model name or base_url
# and you didn't intend to switch (e.g. a crashed hermes-fast session left
# the config swapped).

HERMES=$HOME/.local/bin/hermes
"$HERMES" config set model.base_url "http://rog:8080/v1" >/dev/null
"$HERMES" config set model.default  "gemma-4-26B-A4B-it-UD-Q4_K_XL.gguf" >/dev/null
echo "reverted: model.default = gemma-4-26B-A4B-it-UD-Q4_K_XL.gguf, base_url = http://rog:8080/v1"
