# /etc/systemd/system/llama-server-heavy.service
# Hermes 4.3 36B — heavy-lift model. Started manually when a skill asks for it.
# DO NOT enable. Only start ad-hoc — running this alongside primary will OOM.
#
# Usage: sudo systemctl stop llama-server-primary && sudo systemctl start llama-server-heavy

[Unit]
Description=llama.cpp serving Hermes 4.3 36B (heavy-lift, manual start)
After=network-online.target
Wants=network-online.target
Conflicts=llama-server-primary.service llama-server-fallback.service

[Service]
Type=simple
User=USER
WorkingDirectory=/home/USER/llama.cpp
ExecStart=/home/USER/llama.cpp/build/bin/llama-server \
  --model /home/USER/models/hermes-4.3-36b/Hermes-4.3-36B-Q4_K_M.gguf \
  --n-gpu-layers 18 \
  --ctx-size 16384 \
  --threads 8 \
  --threads-batch 8 \
  --batch-size 256 \
  --flash-attn \
  --host 0.0.0.0 \
  --port 8081
Restart=no

NoNewPrivileges=true
PrivateTmp=true

# Intentionally no [Install] section — we never want this enabled at boot.
